#ifndef CONFIGURATOR_H_
#define CONFIGURATOR_H_

#include "core/MojServiceRequest.h"
#include "core/MojSignal.h"
#include "CoreDefs.h"

#include <set>
#include <string>
#include <sys/types.h>
#include <unordered_map>
#include <utility>
#include <vector>

inline constexpr MojModeT kCacheDirPerms = S_IRWXU | S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH;
inline constexpr MojModeT kCacheStampPerm = S_IRWXU | S_IRGRP | S_IROTH;

inline constexpr const char* kCacheDir = "@WEBOS_INSTALL_LOCALSTATEDIR@/cache/";
inline constexpr const char* kConfCacheDir = "@WEBOS_INSTALL_LOCALSTATEDIR@/cache/configurator/";

class ConfiguratorCallback;

class Configurator : public MojSignalHandler
{
public:
	using ConfigCollection = std::vector<std::string>;

	enum RunType {
		Configure,
		Reconfigure,
		RemoveConfiguration,
	};

	enum ConfigType {
		ConfigUnknown,
		ConfigApplication,
		ConfigService,
	};

	Configurator(const std::string& id, ConfigType confType, RunType type, BusClient& busClient, const std::string& configDirectory);
	~Configurator() override;

	static void ResetConfigStats();
	static const ConfigCollection& ConfigureOk();
	static const ConfigCollection& ConfigureFailure();

	bool Run();
	virtual const char* ConfiguratorName() const = 0;
	virtual const char* ServiceName() const = 0;

protected:
	virtual ConfiguratorCallback* CreateCallback(const std::string& filePath);

	virtual MojErr ProcessConfig(const std::string& filePath, const std::string& json);
	virtual MojErr ProcessConfigRemoval(const std::string& filePath, const std::string& json);

	virtual MojErr ProcessConfig(const std::string& filePath, MojObject& json) = 0;
	virtual MojErr ProcessConfigRemoval(const std::string& filePath, MojObject& json) = 0;

	void MarkConfigured(const std::string& confFile) const;
	void UnmarkConfigured(const std::string& confFile) const;
	virtual bool CanCacheConfiguratorStatus(const std::string& confFile) const;

	const std::string& ParentId(const std::string& filePath) const;

	BusClient& m_busClient;
	const std::string m_id;
	const ConfigType m_confType;

private:
	// Key: /full/path/to/config/file. Value: the directory it was found in under the
	// configurator's directory, which names the app or service it belongs to.
	using ConfigMap = std::unordered_map<std::string, std::string>;

	// The directories a scan has been in, by device and inode, so that a symlink back up
	// the tree does not send it round in circles.
	using VisitedDirs = std::set<std::pair<dev_t, ino_t>>;

	void InitCacheDir() const;
	bool IsAlreadyConfigured(const std::string& confFile) const;
	bool GetConfigFiles(const std::string& parent, const std::string& directory);
	bool GetConfigFiles(const std::string& parent, const std::string& directory, VisitedDirs& visited);
	std::string ReadFile(const std::string& filePath) const;
	std::string ProcessedChecksum(const std::string& confFile) const;
	void Complete();
	MojErr BusResponseAsync(const std::string& filePath, MojObject& response, MojErr err, bool* cacheConfigured);

	ConfigMap m_parentDirMap;
	// Key: /full/path/to/config/file. Value: the checksum of the contents Run() read and sent
	// for it, which is what its stamp records once the service has answered.
	ConfigMap m_processedChecksums;
	ConfigCollection m_configs;
	ConfigCollection m_pendingConfigs;
	const RunType m_currentType;
	bool m_completed = false;
	const std::string m_configDir;
	bool m_emptyConfigurator = false;
	bool m_scanned = false;

	static ConfigCollection m_configureOk;
	static ConfigCollection m_configureFailed;

	friend class ConfiguratorCallback;
	// tests/unit reaches the private parts through this
	friend struct ConfiguratorTestAccess;
};

class ConfiguratorCallback : public MojSignalHandler
{
public:
	using GenericResponse = MojServiceRequest::ReplySignal::Slot<ConfiguratorCallback>;

	ConfiguratorCallback(Configurator* configurator, const std::string& filePath);
	~ConfiguratorCallback() override;

	GenericResponse m_slot;

protected:
	// configuration-specific handler
	virtual MojErr Response(MojObject& response, MojErr err) = 0;

	// Called at most once: either from within Response, or by ResponseWrapper once
	// Response has returned MojErrNone.
	MojErr DelegateResponse(MojObject& response, MojErr err);

	// Marks the config file as processed even though the service returned an error, for
	// a service that answers with a specific error when the thing is already there
	// (activitymanager, filecache). Without an error the default behaviour is kept.
	void MarkConfigured();

	// Marks the config file as not configured. Without an error the default behaviour is
	// kept.
	void UnmarkConfigured();

	// the configuration that made this request
	const std::string m_config;

private:
	using ConfiguratorPtr = MojRefCountedPtr<Configurator>;

	ConfiguratorPtr m_handler;
	bool m_delegateInvoked = false;
	bool m_defaultCacheBehaviourUsed = false;
	// at most one of these is set
	bool m_unconfigure = false;
	bool m_configure = false;

	MojErr ResponseWrapper(MojObject& response, MojErr err);
};

class DefaultConfiguratorCallback : public ConfiguratorCallback
{
public:
	using ConfiguratorCallback::ConfiguratorCallback;

protected:
	MojErr Response(MojObject& response, MojErr err) override;
};

#endif /* CONFIGURATOR_H_ */
